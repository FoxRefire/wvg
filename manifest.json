{
  "manifest_version": 3,
  "name": "Widevine L3 Decrypter",
  "version": "260924.1",
  "version_name": "1765416",
  "description": "Read the Widevine license traffic of the current page and turn it into content keys.",
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "<all_urls>"
      ],
      "world": "MAIN",
      "js": [
        "inject.js"
      ],
      "all_frames": true
    },
    {
      "run_at": "document_start",
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Widevine Decrypter",
    "default_popup": "popup/main.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
